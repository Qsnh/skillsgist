{
  "name": "skillsgist",
  "version": "1.0.0",
  "description": "A private Agent Skills registry you self-host with Node.js, SQLite and S3-compatible storage.",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "ai-agents",
    "registry",
    "self-hosted",
    "sqlite",
    "s3",
    "docker",
    "hono"
  ],
  "homepage": "https://github.com/Qsnh/skillsgist#readme",
  "bugs": {
    "url": "https://github.com/Qsnh/skillsgist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qsnh/skillsgist.git"
  },
  "license": "MIT",
  "author": "Qsnh",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently \"tailwindcss -i src/app.css -o public/app.css --watch\" \"tsx watch --env-file-if-exists=.env src/server.ts\"",
    "build": "npm run build:css && npm run build:server",
    "build:css": "tailwindcss -i src/app.css -o public/app.css --minify",
    "build:server": "esbuild src/server.ts src/reset-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outdir=dist",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "reset-password": "node --env-file-if-exists=.env dist/reset-password.js",
    "typecheck": "tsc --noEmit",
    "verify:cli": "node scripts/verify-cli.mjs",
    "logo": "node scripts/export-logo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "fixtures": "./scripts/make-fixtures.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "marked": "^18.0.13",
    "mmdb-lib": "^3.0.3",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
